# Telegram account phone in international format, e.g. +1234567890
TELEGRAM_PHONE=

# Read-only scanner settings
SCAN_INTERVAL_SECONDS=60
REQUEST_PAUSE_SECONDS=1.5
MAX_PAGES_PER_GIFT=2
PAGE_SIZE=50
MAX_ALERT_PRICE_STARS=400
